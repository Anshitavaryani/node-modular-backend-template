# Copy to .env and fill in. Values in .env are read at start-up; a value already set in the environment wins.
# Quote any value that contains "#".

APP_NAME=backend-template
NODE_ENV=development
PORT=5000
# Scheduled jobs (src/jobs.js) run unless this is false.
JOBS_ENABLED=true

# MariaDB/MySQL. With docker compose, the host is "mysql" inside the network and "localhost" from your machine.
CENTRAL_MYSQL_HOST=localhost
CENTRAL_MYSQL_PORT=3306
CENTRAL_MYSQL_USER=app
CENTRAL_MYSQL_PASSWORD=app
CENTRAL_MYSQL_DB=app_db

# Redis: rate limits, one-time-code cooldowns, login lockouts. Required (the app will not start without it).
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Prefix for every key this app writes (lets one Redis server serve several apps).
REDIS_KEY_PREFIX=

# JWT: at least 32 characters in production (openssl rand -hex 32).
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30
ADMIN_TOKEN_HOURS=12

# Comma-separated origins that may call the API from a browser.
ACCESSDOMAINS=http://localhost:3000,http://localhost:3001
API_BASE_URL=http://localhost:5000
WEBSITE_URL=http://localhost:3001
ADMIN_URL=http://localhost:3000
DEFAULT_API_DATA_LIMIT=15
DEFAULT_TIMEZONE=UTC

# Email. MAIL_TRANSPORT=log prints messages to the console instead of sending them.
MAIL_TRANSPORT=log
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=

# Stripe (shared/billing). Leave empty until payments are switched on.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Role and department IDs must match the seeded rows (src/core/db/seeds/roles.sql, departments.sql).
SUP_ADM_ROLE_ID=1
ADM_ROLE_ID=2
USR_ROLE_ID=6
# Roles a person may choose at self-registration (header role_id). Only the user role by default.
SELF_REGISTERABLE_ROLE_IDS=
ADM_DEPT_ID=2

# The first admin, created by `npm run auth`.
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD="ChangeMe#12345"
