{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "env": {
    "node": true,
    "es2022": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "no-undef": "error",
    "no-unused-vars": ["warn", { "args": "none", "caughtErrors": "none" }]
  },
  "ignorePatterns": ["node_modules/**", "storage/**", "coverage/**", "vendor/**"]
}
