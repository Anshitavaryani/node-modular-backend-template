{
  "apps": [
    {
      "name": "backend-template",
      "script": "index.js",
      "exec_mode": "fork",
      "instances": 1,
      "autorestart": true,
      "watch": false,
      "time": true,
      "max_memory_restart": "500M",
      "kill_timeout": 12000,
      "listen_timeout": 8000,
      "wait_ready": false,
      "min_uptime": "10s",
      "max_restarts": 10,
      "env": { "NODE_ENV": "production" }
    }
  ]
}
